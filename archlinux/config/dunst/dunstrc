[global]
monitor = 0
follow = mouse
width = 300
height = 300
origin = top-right
offset = 20x20
scale = 0
notification_limit = 5

idle_threshold = 120
history_length = 20
show_indicators = yes





font = JetBrainsMono 10
word_wrap = yes
ellipsize = middle
markup = full
# format = "<b>%s</b>\n%b"
format = "<span size='11300'><b>%s</b></span>\n<span size='9000'>%b</span>"

alignment = left
vertical_alignment = center





frame_width = 2
frame_color = "#6c82aae3"
separator_color = frame
separator_height = 2
corner_radius = 15

padding = 10
horizontal_padding = 12

icon_position = left
max_icon_size = 50





mouse_left_click = close_current
mouse_middle_click = do_action
mouse_right_click = close_all






[urgency_low]
background = "#2c4875cc"
foreground = "#ffffff"
timeout = 3

[urgency_normal]
background = "#2c4875cc"
foreground = "#ffffff"
timeout = 5

[urgency_critical]
background = "#2c4875cc"
foreground = "#ffffff"
frame_color = "#6c82aae3"
timeout = 0