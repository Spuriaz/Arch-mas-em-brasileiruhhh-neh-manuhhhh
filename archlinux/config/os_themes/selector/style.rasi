configuration {
    show-icons:                 false;
}

* {
    font: "JetBrainsMono Nerd Font 12";
    bg: #11111bbc;
    fg: #cdd6f4ff;
    accent: #56609Dff;
    background-color: transparent;
}

window {
    width: 400px;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    background-color: @bg;
}

mainbox {
    padding: 20px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    margin: 0px 0px 10px 0px;
    children: [ "prompt" ];
}

prompt {
    background-color: @accent;
    text-color: @fg;
    padding: 8px 12px;
    border-radius: 6px;
}

listview {
    lines: 5;
    fixed-height: false;
}

element {
    padding: 8px;
    border-radius: 6px;
}

element selected {
    background-color: @accent;
    text-color: @fg;
}

element-text {
    text-color: inherit;
    background-color: transparent;
    text-color: @fg;
}